<?xml version="1.0" encoding="UTF-8"?>
<!-- VPOT 产品定义(纯 WiX,无 Go 模板、无 WixUIExtension/WixUtilExtension 依赖)。
     @VERSION@ / @UPGRADE_CODE@ 由构建脚本 sed 渲染。
     默认安装目录 D:\vpot(可在 InstallDirDlg 中修改)。 -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

   <Product Id="BBBBBBBB-1111-2222-3333-444455556666"
            UpgradeCode="@UPGRADE_CODE@"
            Name="VPOT"
            Version="@VERSION@"
            Manufacturer="lib10"
            Language="1033" Codepage="@CODEPAGE@">

      <Package InstallerVersion="200" Compressed="yes"
               Description="VPOT @VERSION@"
               Comments="VPOT" InstallScope="perMachine"/>

      <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>

      <!-- 目录:默认 D:\vpot -->
      <Directory Id="TARGETDIR" Name="SourceDir">
         <Directory Id="ProgramMenuFolder"/>
         <Directory Id="INSTALLDIR" Name="vpot">
            <Component Id="AppFilesCmd" Guid="CCCCCCCC-0000-0000-0000-000000000001">
               <File Id="FileCmd" Source="install-windows.cmd" KeyPath="yes"/>
            </Component>
            <Component Id="AppFilesCompose" Guid="CCCCCCCC-0000-0000-0000-000000000002">
               <File Id="FileCompose" Source="docker-compose.yaml" KeyPath="yes"/>
            </Component>
            <Component Id="AppFilesReadme" Guid="CCCCCCCC-0000-0000-0000-000000000003">
               <File Id="FileReadme" Source="readme.txt" KeyPath="yes"/>
            </Component>
         </Directory>
      </Directory>

      <!-- 开始菜单快捷方式:指向 install-windows.cmd -->
      <DirectoryRef Id="ProgramMenuFolder">
         <Component Id="AppShortcut" Guid="CCCCCCCC-0000-0000-0000-000000000004">
            <Shortcut Id="VPOTShortcut" Name="VPOT" Description="VPOT setup and launch wizard"
                      Target="[INSTALLDIR]install-windows.cmd" WorkingDirectory="INSTALLDIR"/>
            <RemoveFolder Id="RemoveProgramMenuVPOT" Directory="ProgramMenuFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\lib10\VPOT" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
         </Component>
      </DirectoryRef>

      <Feature Id="ProductFeature" Title="VPOT" Level="1">
         <ComponentRef Id="AppFilesCmd"/>
         <ComponentRef Id="AppFilesCompose"/>
         <ComponentRef Id="AppFilesReadme"/>
         <ComponentRef Id="AppShortcut"/>
      </Feature>

      <!-- 目录选择对话框关联的目录属性 -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR"/>
      <!-- 默认安装目录:D:\vpot(可被 InstallDirDlg 修改) -->
      <Property Id="INSTALLDIR" Value="D:\vpot" Secure="yes"/>

      <!-- UI 序列:欢迎(正常安装先显示)→ 进度 → 完成 -->
      <InstallUISequence>
         <Show Dialog="WelcomeDlg" Before="CostFinalize">NOT Installed</Show>
         <Show Dialog="ProgressDlg" After="CostFinalize">NOT Installed</Show>
         <Show Dialog="ExitDialog" OnExit="success">NOT Installed</Show>
      </InstallUISequence>

   </Product>
</Wix>
