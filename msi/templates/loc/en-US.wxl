<?xml version="1.0" encoding="UTF-8"?>
<WixLocalization Culture="en-US" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <!-- Step 1: WSL info -->
  <String Id="Culture">en-US</String>
  <String Id="WslInfoDlgTitle">Step 1 / 3: Install WSL</String>
  <String Id="WslInfoDlgDescription">Check whether WSL is installed as described below</String>
  <String Id="WslInfoDlgBody">[Check]&#13;&#10;Open Command Prompt (cmd) and run: wsl --status&#13;&#10;Version info shown -> WSL is installed, click &quot;Next&quot;&#13;&#10;Command not found -> install it:&#13;&#10;[Install]&#13;&#10;Run in an admin PowerShell: wsl --install</String>

  <!-- Step 2: Docker info -->
  <String Id="DockerInfoDlgTitle">Step 2 / 3: Install Docker</String>
  <String Id="DockerInfoDlgDescription">Check whether Docker Desktop is installed as described below, and start Docker Desktop</String>
  <String Id="DockerInfoDlgBody">[Check]&#13;&#10;Open Command Prompt (cmd) and run: docker info&#13;&#10;It responds -> Docker Desktop is running, click &quot;Next&quot;&#13;&#10;[Install]&#13;&#10;Not installed -> download Docker Desktop from:&#13;&#10;https://www.docker.com/products/docker-desktop/&#13;&#10;Start Docker Desktop after installation</String>

  <!-- Step 3: Installation about to complete -->
  <String Id="RunCmdInfoDlgTitle">After Installation</String>
  <String Id="RunCmdInfoDlgDescription">After installation completes, follow the documentation to install a Claw instance</String>
  <String Id="RunCmdInfoDlgBody">After installation:&#13;&#10;1. Open the Start Menu and run &quot;VPOT&quot; (install-image.cmd)&#13;&#10;2. The script will detect WSL / Docker and deploy containers&#13;&#10;3. After deployment, visit: https://127.0.0.1:18800&#13;&#10;See readme.txt in the install directory for details</String>

  <!-- Buttons -->
  <String Id="ButtonText_Back">&lt; Back</String>
  <String Id="ButtonText_Next">Next &gt;</String>
  <String Id="ButtonText_Cancel">Cancel</String>
  <String Id="ButtonText_Finish">Finish</String>

  <!-- Standard dialogs -->
  <String Id="WelcomeDlgTitle">VPOT Setup Wizard</String>
  <String Id="WelcomeDlgDescription">Welcome to the VPOT installer</String>
  <String Id="WelcomeDlgBody">This wizard will install VPOT on your computer.&#13;&#10;&#13;&#10;Click &quot;Next&quot; to continue.</String>

  <!-- Upgrade detection -->
  <String Id="OldVersionDlgTitle">Previous Version Detected</String>
  <String Id="OldVersionDlgDescription">A previous version of VPOT is installed</String>
  <String Id="OldVersionDlgBody">A previous version of VPOT was found on this computer.&#13;&#10;&#13;&#10;Click &quot;Uninstall &amp; Continue&quot; to uninstall the old version first, then install the new one;&#13;&#10;click &quot;Cancel&quot; to exit the installation.</String>
  <String Id="OldVersionDlgNext">Uninstall &amp; Continue</String>
  <String Id="InstallDirDlgTitle">Choose Install Location</String>
  <String Id="InstallDirDlgDescription">Installation directory</String>
  <String Id="InstallDirDlgFolderLabel">Installation directory:</String>
  <String Id="ProgressDlgTitle">Installing VPOT</String>
  <String Id="ProgressDlgText">Please wait while files are being installed...</String>
  <String Id="ExitDialogTitle">Installation Complete</String>
  <String Id="ExitDialogDescription">VPOT was installed successfully</String>
  <String Id="ExitDialogRemoveTitle">Removal Complete</String>
  <String Id="ExitDialogRemoveBody">VPOT was removed successfully.&#13;&#10;Thank you for using VPOT.</String>
  <String Id="ExitDialogBody">Open the Start Menu and run &quot;VPOT&quot; (install-image.cmd) to finish environment checks and container deployment.&#13;&#10;Visit https://127.0.0.1:18800 once the service is up.</String>
  <String Id="ProgressDlgDescription">Please wait while VPOT is being installed.</String>
  <String Id="WindowTitle">VPOT Setup</String>
  <String Id="ButtonText_Install">Install</String>
  <String Id="ButtonText_Repair">Repair</String>
  <String Id="ButtonText_Remove">Remove</String>
  <String Id="ButtonText_Yes">Yes</String>
  <String Id="ButtonText_No">No</String>
  <String Id="VerifyReadyDlgTitle">Ready to Install</String>
  <String Id="VerifyReadyDlgDescription">Confirm your installation settings</String>
  <String Id="VerifyReadyDlgBody">VPOT will be installed to: [INSTALLDIR].&#13;&#10;Click &quot;Install&quot; to begin.</String>
  <String Id="MaintenanceWelcomeDlgTitle">Maintain VPOT</String>
  <String Id="MaintenanceWelcomeDlgDescription">Choose what you want to do with VPOT.</String>
  <String Id="MaintenanceWelcomeDlgBody">You can repair or remove the VPOT installation.&#13;&#10;Click &quot;Next&quot; to continue.</String>
  <String Id="MaintenanceTypeDlgTitle">Repair or remove installation</String>
  <String Id="MaintenanceTypeDlgDescription">Choose the operation you want to perform.</String>
  <String Id="MaintenanceTypeDlgRepairButton">Repair installation</String>
  <String Id="MaintenanceTypeDlgRemoveButton">Remove installation</String>
  <String Id="CancelDlgText">Are you sure you want to cancel?</String>
  <String Id="ButtonText_OK">OK</String>
  <String Id="InstallDirDlgChangeFolder">Change...</String>
  <String Id="BrowseDlgComboLabel">Look in:</String>
  <String Id="BrowseDlgPathLabel">Folder name:</String>
  <String Id="InvalidDirDlgText">The path you entered is invalid. Please enter a valid installation path.</String>
  <String Id="WslInfoDlgBtnInstall">WSL official installer</String>
  <String Id="WslInfoDlgBtnDownload">WSL mirror installer</String>
  <String Id="DockerInfoDlgBtnDownload">Docker Desktop installer</String>
</WixLocalization>
