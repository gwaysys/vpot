<?xml version="1.0" encoding="UTF-8"?>
<WixLocalization Culture="en-US" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <!-- Step 1: WSL info -->
  <String Id="WslInfoDlgTitle">Step 1 / 3: Install WSL</String>
  <String Id="WslInfoDlgDescription">Check whether WSL is installed per the document below; install it if not.</String>
  <String Id="WslInfoDlgBody">{&amp;}Document: Check &amp; Install WSL&#13;&#10;&#13;&#10;[Check if installed]&#13;&#10;1. Open Command Prompt (cmd);&#13;&#10;2. Run: wsl --status;&#13;&#10;3. If version info of &quot;Windows Subsystem for Linux&quot; is shown -> installed, click &quot;Next&quot;;&#13;&#10;   If it says not installed or command not found -> install per the steps below.&#13;&#10;&#13;&#10;[Install WSL]&#13;&#10;1. Open PowerShell as Administrator, run: wsl --install;&#13;&#10;2. Or download the installer:&#13;&#10;   https://lib10.cn/download/wsl.2.7.11.0.x64.msi&#13;&#10;3. Reboot after installation;&#13;&#10;4. Reopen a terminal and run wsl --status to confirm.</String>

  <!-- Step 2: Docker info -->
  <String Id="DockerInfoDlgTitle">Step 2 / 3: Install Docker</String>
  <String Id="DockerInfoDlgDescription">Check whether Docker is installed per the document below; install it if not.</String>
  <String Id="DockerInfoDlgBody">{&amp;}Document: Check &amp; Install Docker&#13;&#10;&#13;&#10;[Check if installed]&#13;&#10;1. Open Command Prompt (cmd);&#13;&#10;2. Run: docker --version;&#13;&#10;3. If a version number is shown -> installed, click &quot;Next&quot;;&#13;&#10;   If docker is not recognized -> install per the steps below.&#13;&#10;&#13;&#10;[Install Docker]&#13;&#10;1. Download Docker Desktop:&#13;&#10;   https://www.docker.com/products/docker-desktop/&#13;&#10;2. After installation, log out and back in (or reboot);&#13;&#10;3. Reopen a terminal and run docker --version to confirm.</String>

  <!-- Step 3: Installation about to complete -->
  <String Id="RunCmdInfoDlgTitle">Installation About to Complete</String>
  <String Id="RunCmdInfoDlgDescription">Installation is almost complete. Finish installing claw per the document below.</String>
  <String Id="RunCmdInfoDlgBody">{&amp;}After installation:&#13;&#10;1. Open the Start Menu and click &quot;VPOT&quot; (install-windows.cmd);&#13;&#10;2. The script checks WSL and Docker, guides installing claw and starts the service;&#13;&#10;3. Visit https://127.0.0.1:18800 in your browser once the service is up.&#13;&#10;&#13;&#10;[Installation directory structure]&#13;&#10;D:\vpot\&#13;&#10;|-- install-windows.cmd   Setup wizard (run it)&#13;&#10;|-- docker-compose.yaml   Container orchestration&#13;&#10;`-- readme.txt            Documentation&#13;&#10;&#13;&#10;Clicking &quot;Finish&quot; will open the installation directory.</String>

  <!-- Buttons -->
  <String Id="ButtonText_Back">&lt; Back</String>
  <String Id="ButtonText_Next">Next &gt;</String>
  <String Id="ButtonText_Cancel">Cancel</String>
  <String Id="ButtonText_Finish">Finish</String>

  <!-- Standard dialogs -->
  <String Id="WelcomeDlgTitle">VPOT Setup Wizard</String>
  <String Id="WelcomeDlgDescription">Welcome to the VPOT installer</String>
  <String Id="WelcomeDlgBody">This wizard will install VPOT on your computer.&#13;&#10;&#13;&#10;Click &quot;Next&quot; to continue.</String>

  <!-- Upgrade detection -->
  <String Id="OldVersionDlgTitle">Previous Version Detected</String>
  <String Id="OldVersionDlgDescription">A previous version of VPOT is installed</String>
  <String Id="OldVersionDlgBody">A previous version of VPOT was found on this computer.&#13;&#10;&#13;&#10;Click &quot;Uninstall &amp; Continue&quot; to uninstall the old version first, then install the new one;&#13;&#10;click &quot;Cancel&quot; to exit the installation.</String>
  <String Id="OldVersionDlgNext">Uninstall &amp; Continue</String>
  <String Id="InstallDirDlgTitle">Choose Install Location</String>
  <String Id="InstallDirDlgDescription">Select the destination folder for VPOT</String>
  <String Id="InstallDirDlgFolderLabel">Default D:\vpot, editable:</String>
  <String Id="ProgressDlgTitle">Installing VPOT</String>
  <String Id="ProgressDlgText">Please wait while files are being installed...</String>
  <String Id="ExitDialogTitle">Installation Complete</String>
  <String Id="ExitDialogDescription">VPOT was installed successfully</String>
  <String Id="ExitDialogBody">Open the Start Menu and run &quot;VPOT&quot; (install-windows.cmd) to finish environment checks and container deployment.&#13;&#10;Visit https://127.0.0.1:18800 once the service is up.</String>
  <String Id="ProgressDlgDescription">Please wait while VPOT is being installed.</String>
  <String Id="WindowTitle">VPOT Setup</String>
  <String Id="ButtonText_Install">Install</String>
  <String Id="ButtonText_Repair">Repair</String>
  <String Id="ButtonText_Remove">Remove</String>
  <String Id="ButtonText_Change">Change</String>
  <String Id="ButtonText_Yes">Yes</String>
  <String Id="ButtonText_No">No</String>
  <String Id="VerifyReadyDlgTitle">Ready to Install</String>
  <String Id="VerifyReadyDlgDescription">Confirm your installation settings</String>
  <String Id="VerifyReadyDlgInstallText">Click &quot;Install&quot; to begin installing VPOT.</String>
  <String Id="VerifyReadyDlgRepairText">Click &quot;Repair&quot; to repair the VPOT installation.</String>
  <String Id="VerifyReadyDlgRemoveText">Click &quot;Remove&quot; to remove VPOT from your computer.</String>
  <String Id="VerifyReadyDlgChangeText">Click &quot;Change&quot; to change the VPOT installation.</String>
  <String Id="MaintenanceWelcomeDlgTitle">Maintain VPOT</String>
  <String Id="MaintenanceWelcomeDlgDescription">Choose what you want to do with VPOT.</String>
  <String Id="MaintenanceWelcomeDlgBody">You can change, repair or remove the VPOT installation.&#13;&#10;Click &quot;Next&quot; to continue.</String>
  <String Id="MaintenanceTypeDlgTitle">Change, repair or remove installation</String>
  <String Id="MaintenanceTypeDlgDescription">Choose the operation you want to perform.</String>
  <String Id="MaintenanceTypeDlgChangeButton">Change installation</String>
  <String Id="MaintenanceTypeDlgRepairButton">Repair installation</String>
  <String Id="MaintenanceTypeDlgRemoveButton">Remove installation</String>
  <String Id="CancelDlgText">Are you sure you want to cancel?</String>
</WixLocalization>
