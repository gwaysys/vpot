<?xml version="1.0" encoding="UTF-8"?>
<WixLocalization Culture="zh-CN" Codepage="936" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <!-- 第 1 步:WSL 说明(文档化) -->
  <String Id="WslInfoDlgTitle">第 1 步 / 3:安装 WSL</String>
  <String Id="WslInfoDlgDescription">请按以下说明检查 WSL 是否已安装</String>
  <String Id="WslInfoDlgBody">【确认】&#13;&#10;打开命令提示符(cmd),执行:wsl --status&#13;&#10;显示版本信息 → 已安装,点&quot;下一步&quot;&#13;&#10;命令不存在 → 请先安装:&#13;&#10;【安装】&#13;&#10;管理员 PowerShell 执行:wsl --install</String>

  <!-- 第 2 步:Docker 说明(文档化) -->
  <String Id="DockerInfoDlgTitle">第 2 步 / 3:安装 Docker</String>
  <String Id="DockerInfoDlgDescription">请按以下说明检查 Docker-Desktop 是否已安装,并启动 Docker-Desktop</String>
  <String Id="DockerInfoDlgBody">【确认】&#13;&#10;打开命令提示符(cmd),执行:docker info&#13;&#10;有响应 → Docker Desktop 已运行,点&quot;下一步&quot;&#13;&#10;【安装】&#13;&#10;未安装 → 从官网下载 Docker Desktop:&#13;&#10;https://www.docker.com/products/docker-desktop/&#13;&#10;安装后请启动 Docker Desktop</String>

  <!-- 第 3 步:安装即将完成(含目录结构与 claw 安装) -->
  <String Id="RunCmdInfoDlgTitle">安装完成后</String>
  <String Id="RunCmdInfoDlgDescription">完成安装后按文档进一步安装 Claw 实例</String>
  <String Id="RunCmdInfoDlgBody">安装完成后:&#13;&#10;1. 打开开始菜单,运行&quot;VPOT&quot;(install-windows.cmd)&#13;&#10;2. 脚本将自动检测 WSL / Docker 并部署容器&#13;&#10;3. 部署完成后访问:https://127.0.0.1:18800&#13;&#10;详细文档见安装目录 readme.txt</String>

  <!-- 按钮 -->
  <String Id="ButtonText_Back">&lt; 上一步</String>
  <String Id="ButtonText_Next">下一步 &gt;</String>
  <String Id="ButtonText_Cancel">取消</String>
  <String Id="ButtonText_Finish">完成</String>

  <!-- 标准对话框 -->
  <String Id="WelcomeDlgTitle">VPOT 安装向导</String>
  <String Id="WelcomeDlgDescription">欢迎使用 VPOT 安装程序</String>
  <String Id="WelcomeDlgBody">本向导将安装 VPOT 到您的计算机。&#13;&#10;&#13;&#10;点击&quot;下一步&quot;继续。</String>

  <!-- 升级检测 -->
  <String Id="OldVersionDlgTitle">检测到旧版本</String>
  <String Id="OldVersionDlgDescription">已安装 VPOT 的旧版本</String>
  <String Id="OldVersionDlgBody">检测到计算机上已安装 VPOT 的旧版本。&#13;&#10;&#13;&#10;点击&quot;卸载并继续&quot;将先卸载旧版本,再安装新版本;&#13;&#10;点击&quot;取消&quot;将退出安装。</String>
  <String Id="OldVersionDlgNext">卸载并继续</String>
  <String Id="InstallDirDlgTitle">选择安装位置</String>
  <String Id="InstallDirDlgDescription">安装目录</String>
  <String Id="InstallDirDlgFolderLabel">安装目录:</String>
  <String Id="ProgressDlgTitle">正在安装 VPOT</String>
  <String Id="ProgressDlgText">请稍候,正在安装文件...</String>
  <String Id="ExitDialogTitle">安装完成</String>
  <String Id="ExitDialogDescription">VPOT 已成功安装</String>
  <String Id="ExitDialogRemoveBody">VPOT 已成功移除。&#13;&#10;感谢使用,再见。</String>
  <String Id="ExitDialogBody">请打开开始菜单,运行 &quot;VPOT&quot;(install-windows.cmd)完成环境检测与容器部署。&#13;&#10;服务启动后访问 https://127.0.0.1:18800。</String>
  <String Id="ProgressDlgDescription">请稍候,正在安装 VPOT。</String>
  <String Id="WindowTitle">VPOT 安装</String>
  <String Id="ButtonText_Install">安装</String>
  <String Id="ButtonText_Repair">修复</String>
  <String Id="ButtonText_Remove">移除</String>
  <String Id="ButtonText_Yes">是</String>
  <String Id="ButtonText_No">否</String>
  <String Id="VerifyReadyDlgTitle">即将完成</String>
  <String Id="VerifyReadyDlgDescription">确认安装设置</String>
  <String Id="VerifyReadyDlgBody">VPOT 将安装到:[INSTALLDIR]。&#13;&#10;点击&quot;安装&quot;开始安装。</String>
  <String Id="MaintenanceWelcomeDlgTitle">维护 VPOT</String>
  <String Id="MaintenanceWelcomeDlgDescription">选择要对 VPOT 执行的操作。</String>
  <String Id="MaintenanceWelcomeDlgBody">你可以修复或移除 VPOT 的安装。&#13;&#10;单击&quot;下一步&quot;继续。</String>
  <String Id="MaintenanceTypeDlgTitle">修复或移除安装</String>
  <String Id="MaintenanceTypeDlgDescription">请选择要执行的操作。</String>
  <String Id="MaintenanceTypeDlgRepairButton">修复安装</String>
  <String Id="MaintenanceTypeDlgRemoveButton">移除安装</String>
  <String Id="CancelDlgText">确定要取消吗?</String>
  <String Id="ButtonText_OK">确定</String>
  <String Id="InstallDirDlgChangeFolder">更改…</String>
  <String Id="BrowseDlgComboLabel">查找范围:</String>
  <String Id="BrowseDlgPathLabel">文件夹名:</String>
  <String Id="InvalidDirDlgText">输入的路径无效,请输入有效的安装路径。</String>
  <String Id="WslInfoDlgBtnInstall">WSL官方安装包</String>
  <String Id="WslInfoDlgBtnDownload">WSL镜像安装包</String>
  <String Id="DockerInfoDlgBtnDownload">Docker Desktop 安装包</String>
